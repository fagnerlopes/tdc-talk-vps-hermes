# ---------------------------------------------------------------------------
# TDC Demo — HOSTMASTER + Hermes
# Copie para .env antes de `docker compose up -d`
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev123
POSTGRES_DB=hermes_demo

# API
DATABASE_URL=postgresql://dev_user:dev123@postgres:5432/hermes_demo
LOG_LEVEL=info
LOG_FILE=/var/log/app/api.log
PORT=3001

# Determinismo da demo (ver RUNBOOK-LIVE.md)
CHECKOUT_FAILURE_RATE=0.5
CHECKOUT_MAX_SUCCESS_STREAK=3

# Boot
SEED_ON_BOOT=true

# Web (Next.js) — resolvido em RUNTIME pelo proxy, nao em build time
API_INTERNAL_URL=http://api:3001

# Loki — basic-auth do servico loki-auth (obrigatoria; o container aborta sem ela)
#
# Linha htpasswd em BASE64. Base64 porque o `$` do hash nao sobrevive a
# interpolacao do Compose — ver monitoring/loki-auth-htpasswd.sh.
#
# Gerar:
#   printf '%s' "hermes:$(openssl passwd -apr1 '<senha>')" | base64 -w0
#
# NUNCA commitar o valor real: este repositorio e publico.
LOKI_BASIC_AUTH_B64=

# Primeiro admin do painel (so tem efeito quando a tabela admin_users esta vazia)
ADMIN_EMAIL=admin@hostmaster.local
# Se ausente, o seed gera 24 caracteres e imprime UMA VEZ no log do container.
# NUNCA commitar o valor real: este repositorio e publico.
ADMIN_PASSWORD=

# Validade da sessao do painel, em horas
SESSION_TTL_HOURS=12

# Senha do admin do Grafana (o usuario e sempre `admin`)
#
# OBRIGATORIA: sem ela o container aborta no boot, do mesmo jeito que o
# loki-auth aborta sem LOKI_BASIC_AUTH_B64. O motivo e o mesmo — sem senha o
# Grafana sobe com admin/admin num dominio publico.
#
# ATENCAO: o Grafana so aplica esta variavel no PRIMEIRO boot de um volume novo.
# Com grafana_data ja existente, quem aplica e a CLI chamada pelo
# monitoring/grafana-entrypoint.sh. Nao ha nada a fazer alem de definir a
# variavel — so nao se assuste ao ver "reset-admin-password" no log a cada boot.
#
# NUNCA commitar o valor real: este repositorio e publico.
GRAFANA_ADMIN_PASSWORD=
