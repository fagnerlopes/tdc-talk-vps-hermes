# ---------------------------------------------------------------------------
# TDC Demo — HOSTMASTER + Hermes
# Copie para .env antes de `docker compose up -d`
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev123
POSTGRES_DB=hermes_demo

# API
DATABASE_URL=postgresql://dev_user:dev123@postgres:5432/hermes_demo
LOG_LEVEL=info
LOG_FILE=/var/log/app/api.log
PORT=3001

# Determinismo da demo (ver RUNBOOK-LIVE.md)
CHECKOUT_FAILURE_RATE=0.5
CHECKOUT_MAX_SUCCESS_STREAK=3

# Boot
SEED_ON_BOOT=true

# Web (Next.js) — resolvido em RUNTIME pelo proxy, nao em build time
API_INTERNAL_URL=http://api:3001

# Loki — basic-auth no Traefik (so em producao; local nao usa)
# Gerar com:  htpasswd -nbB hermes '<senha>'
#        ou:  echo "hermes:$(openssl passwd -apr1 '<senha>')"
# NUNCA commitar o valor real: este repositorio e publico.
LOKI_BASIC_AUTH=
