# O config viaja DENTRO da imagem, em vez de ser bind-mountado do host.
#
# Por que: o Coolify roda o compose a partir de /artifacts/<deploy-uuid>/ mas
# reescreve os binds relativos para /data/coolify/applications/<app-uuid>/...,
# onde os arquivos nao estao. O Docker entao cria um DIRETORIO vazio no lugar do
# arquivo e o container morre com:
#
#   error mounting ".../monitoring/loki-config.yaml" to rootfs at
#   "/etc/loki/local-config.yaml": not a directory
#
# Diagnosticado no primeiro deploy (psksw8yjogxq4dmlobgwkhi0). Build context
# relativo funciona normalmente — o que quebra e so o bind mount de arquivo.
FROM grafana/loki:3.1.1
COPY loki-config.yaml /etc/loki/local-config.yaml
