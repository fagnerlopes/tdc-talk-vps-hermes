            "description": "Usa o `correlationId` gravado pelo último checkout. Devem vir **exatamente 2 linhas**: início e desfecho."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// O Promtail entrega em lote (batchwait 1s). Sem esta espera, a query roda",
