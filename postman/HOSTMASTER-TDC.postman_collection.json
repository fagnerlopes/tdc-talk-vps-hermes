  "item": [
    {
      "name": "1. Saúde e estado",
      "description": "Leitura pura. Nada aqui altera estado — pode disparar à vontade no meio da live.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/{{version}}/health",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "{{version}}",
                "health"
              ]
            },
            "description": "200 quando saudável. 500 com `{\"error\":\"crashed\"}` depois de um `simulate-crash`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 ou 500 (crashed)', () => pm.expect([200, 500]).to.include(pm.response.code));",
                  "console.log('status:', pm.response.json().status);"
                ]
              }
            }
          ]
        },
        {
          "name": "Status (métricas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/{{version}}/status",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "{{version}}",
                "status"
              ]
            },
            "description": "`failureRate` é a taxa configurada; `observedFailureRate` é a medida desde o start. Antes da live as duas devem estar perto de 0.5."
