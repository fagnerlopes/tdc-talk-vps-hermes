    {
      "name": "4. Investigação no Loki (o que o Hermes faz)",
      "description": "As queries do AGENTE.md. Todas em `POST` com `x-www-form-urlencoded`.\n\nA autenticação básica já está configurada com `{{loki_user}}` / `{{loki_pass}}`. Hoje essas variáveis estão vazias e o Loki ignora o header. Depois que o basic-auth do Traefik entrar, basta preencher no Environment.\n\n**Sobre a espera de 3s:** as duas requests com assercao rigida aguardam antes de consultar, porque o Promtail entrega em lote a cada 1s. Rodar a query imediatamente depois de um checkout devolve vazio por corrida.",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{loki_user}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{loki_pass}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Erros (query do gate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "query",
                  "value": "{job=\"api\"} | json | level=\"error\"",
                  "type": "text"
                },
                {
                  "key": "start",
                  "value": "{{start_ns}}",
                  "type": "text"
                },
                {
                  "key": "end",
                  "value": "{{end_ns}}",
                  "type": "text"
                },
                {
                  "key": "limit",
                  "value": "100",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{loki_url}}/loki/api/v1/query_range",
              "host": [
                "{{loki_url}}"
              ],
              "path": [
                "loki",
                "api",
                "v1",
                "query_range"
              ]
            },
            "description": "Se esta retornar vazio, a talk cai. É a checagem que decide tudo."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// O Promtail entrega em lote (batchwait 1s). Sem esta espera, a query roda",
                  "// antes da linha chegar ao Loki e a assercao falha por corrida, nao por bug.",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const linhas = pm.response.json().data.result.flatMap(r => r.values);",
                  "pm.test('achou pelo menos uma linha de erro', () => pm.expect(linhas.length).to.be.above(0));",
                  "if (linhas.length) console.log(JSON.parse(linhas[0][1]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erros no checkout da versão",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "query",
                  "value": "{job=\"api\"} | json | endpoint=\"/{{version}}/checkout\" | level=\"error\"",
                  "type": "text"
